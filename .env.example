# Local: PGlite persistente, dispensando instalação de PostgreSQL.
PORT=3001
HOST=127.0.0.1
DATA_DIR=.data/pg
APP_ORIGIN=http://localhost:5173
# PostgreSQL de produção / homologação (com TLS conforme configuração do provedor):
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/agenda
# NODE_ENV=production
# APP_ORIGIN=https://seu-dominio.com.br
# BRAND_HOSTS={"pet.seudominio.com.br":"petflow","barber.seudominio.com.br":"barberflow"}
# Origem alternativa por domínio deve constar em APP_ORIGINS, separada por vírgula.
# APP_ORIGINS=https://pet.seudominio.com.br,https://barber.seudominio.com.br
